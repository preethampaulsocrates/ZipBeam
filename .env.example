# SwiftDrop Environment Configuration
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ──────────────────────────────────────────
# Session expiry in milliseconds (default: 30 minutes)
SESSION_EXPIRY_MS=1800000

# ─── File Limits ──────────────────────────────────────
# Max file size in bytes (default: 2 GB)
MAX_FILE_SIZE=2147483648

# Max files per upload request
MAX_FILES_PER_REQUEST=20

# ─── Storage ──────────────────────────────────────────
# 'local' | 'aws-s3' | 'cloudflare-r2'
STORAGE_PROVIDER=local

# For local storage
UPLOAD_DIR=./uploads

# For AWS S3 (leave blank if using local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# For Cloudflare R2 (leave blank if using local)
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins (* for all)
ALLOWED_ORIGINS=*
